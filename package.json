    "package:portable": "node scripts/package.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5",
    "vite": "^7"
  },
  "description": "Offline NCM to MP3 decoder for Windows, macOS Apple Silicon and Linux",
